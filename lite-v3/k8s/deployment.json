{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "empire-architecture",
    "labels": {
      "app": "empire"
    }
  },
  "spec": {
    "replicas": 1,
    "selector": {
      "matchLabels": {
        "app": "empire"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "empire"
        }
      },
      "spec": {
        "containers": [
          {
            "name": "empire",
            "image": "empire-architecture:latest",
            "ports": [
              {
                "containerPort": 8501
              }
            ],
            "env": [
              {
                "name": "MIMO_API_KEY",
                "valueFrom": {
                  "secretKeyRef": {
                    "name": "empire-secrets",
                    "key": "mimo-api-key"
                  }
                }
              }
            ],
            "resources": {
              "requests": {
                "cpu": "500m",
                "memory": "512Mi"
              },
              "limits": {
                "cpu": "2000m",
                "memory": "2Gi"
              }
            },
            "livenessProbe": {
              "exec": {
                "command": [
                  "python3",
                  "-c",
                  "print('OK)"
                ]
              },
              "periodSeconds": 30
            }
          }
        ]
      }
    }
  }
}